# Python
__pycache__/
*.py[cod]
.venv/

# Data — raw pulls and the lake DB are local artifacts, not source
data/raw/*
# Keyed-feed snapshots cited by committed artifacts must be committed so the
# recorded sha256 can be re-verified (check_freshness.py enforces this).
!data/raw/statyx/
!data/raw/fastballapi/
!data/raw/manifest.jsonl
data/mlb_lake.db

# OS
.DS_Store

# Generated dashboard artifacts (dashboard/index.html, hardball_demo.html)
# ARE committed: GitHub Pages serves them. Plotly is vendored, pinned, in
# dashboard/vendor/. Regenerate: python src/dashboard_p6.py
dashboard/plotly.min.js


# Analytical warehouse — built from data/curated by src/build_warehouse.py
data/hardball.duckdb
data/.change_watch_state.json

# Claude Code local state (never commit)
.claude/state/
.claude/settings.local.json
.env
.env.*
!.env.example
